<Window x:Class="VisibilityDiagnostic.UI.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visibility Diagnostic Tool (Real-time)" Height="450" Width="550"
        WindowStartupLocation="CenterScreen" Topmost="True" Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Select an element in Revit to diagnose:" Margin="0,0,0,5" FontWeight="Bold"/>
        
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Target View:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="ViewsComboBox" Grid.Column="1" 
                      IsEditable="True" 
                      StaysOpenOnEdit="True" 
                      TextSearch.TextPath="Name"
                      KeyUp="ViewsComboBox_KeyUp"
                      SelectionChanged="ViewsComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ViewTypeName, StringFormat=[{0}]}" Foreground="Gray" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="Waiting for selection..." VerticalAlignment="Center" Foreground="Gray" FontStyle="Italic"/>
            <Button x:Name="CheckButton" Grid.Column="1" Content="Force Refresh" Width="100" Padding="5" Click="CheckButton_Click"/>
        </Grid>

        <TextBlock x:Name="ResultsHeaderTextBlock" Grid.Row="3" Margin="0,0,0,5" TextWrapping="Wrap" FontFamily="Consolas" FontWeight="Bold"/>
        
        <GroupBox Grid.Row="4" Header="Diagnostic Results">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" x:Name="IconText" FontFamily="Segoe UI Emoji" Text="✅" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" FontFamily="Consolas" VerticalAlignment="Top"/>
                            </Grid>
                            
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHiddenReason}" Value="True">
                                    <Setter TargetName="IconText" Property="Text" Value="❌"/>
                                    <Setter TargetName="MessageText" Property="Foreground" Value="Red"/>
                                    <Setter TargetName="MessageText" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                    <Setter TargetName="IconText" Property="Text" Value="➖"/>
                                    <Setter TargetName="MessageText" Property="Foreground" Value="Gray"/>
                                    <Setter TargetName="MessageText" Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
